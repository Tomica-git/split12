{
  "manifest_version": 3,
  "minimum_chrome_version": "128",
  "name": "Split12（最大12分割ビュー）",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "description": "1つのタブに最大12のWebページを並べます。",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webNavigation",
    "storage",
    "contextMenus",
    "tabs",
    "history",
    "favicon",
    "browsingData",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-csrf-isolated.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-csrf-main.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "drag-bridge.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "分割ビューを開く",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+8"
      }
    },
    "pane-increase": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "分割数を増やす"
    },
    "pane-decrease": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "分割数を減らす"
    },
    "new-view": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "新しいビュー"
    },
    "toggle-sidebar": {
      "description": "セッション一覧の開閉"
    },
    "toggle-toolbar": {
      "description": "上部ツールバーの開閉"
    },
    "close-pane": {
      "description": "選択中のタブを削除"
    },
    "layout-undo": {
      "description": "変更を元に戻す"
    },
    "layout-redo": {
      "description": "変更をやり直す"
    },
    "page-back": {
      "description": "選択枠のページを戻る"
    },
    "page-forward": {
      "description": "選択枠のページを進む"
    },
    "split-add": {
      "description": "固定枠を分割して追加"
    },
    "zoom-in": {
      "description": "選択枠を10%拡大"
    },
    "zoom-out": {
      "description": "選択枠を10%縮小"
    },
    "view-up": {
      "description": "一覧の前のビューを選択"
    },
    "view-down": {
      "description": "一覧の次のビューを選択"
    },
    "split-up": {
      "description": "固定枠の上に追加"
    },
    "split-left": {
      "description": "固定枠の左に追加"
    },
    "split-down": {
      "description": "固定枠の下に追加"
    },
    "split-right": {
      "description": "固定枠の右に追加"
    }
  }
}
